{
  "aegis-os-runtime-guard": {
    "PreInvocation": [
      {
        "command": "\"aegis-os\" --org \"aegis-os\" --agent auto --role \"Antigravity (AGY) Lead Agent\" --workspace \"..\" --runtime-dir \"/tmp/aegis-os-runtime\" agy-hook --event PreInvocation --strict-cow",
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"aegis-os\" --org \"aegis-os\" --agent auto --role \"Antigravity (AGY) Lead Agent\" --workspace \"..\" --runtime-dir \"/tmp/aegis-os-runtime\" agy-hook --event PreToolUse --strict-cow",
            "type": "command"
          }
        ],
        "matcher": "call_mcp_tool|mcp_aegis-os_.*|mcp__aegis-os__.*|write_file|edit_file|read_file|view_file|run_command|Write|Edit|MultiEdit|Read|Bash"
      }
    ],
    "SessionStart": [
      {
        "command": "\"aegis-os\" --org \"aegis-os\" --agent auto --role \"Antigravity (AGY) Lead Agent\" --workspace \"..\" --runtime-dir \"/tmp/aegis-os-runtime\" agy-hook --event SessionStart --strict-cow",
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "\"aegis-os\" --org \"aegis-os\" --agent auto --role \"Antigravity (AGY) Lead Agent\" --workspace \"..\" --runtime-dir \"/tmp/aegis-os-runtime\" agy-hook --event Stop --strict-cow",
        "type": "command"
      }
    ],
    "enabled": true
  }
}