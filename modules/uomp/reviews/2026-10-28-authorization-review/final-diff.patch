+test('direct grants preserve manifest denials and field restrictions', async t => {
+  const { auth, guard, store } = await createHarness(t);
+
+  store.set({
+    key: 'portfolio.holdings',
+    value: { symbol: 'AAPL' },
+    tags: ['portfolio', 'secrets'],
+    sensitivity: 'low',
+    source: 'user',
